# ─── Ứng dụng ────────────────────────────────────────────────────────────────
APP_NAME="Hoa Hoang Intra"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=company_db

# ─── Ảnh tải lên ─────────────────────────────────────────────────────────────
# Để trống BLOB_READ_WRITE_TOKEN thì ảnh lưu trên đĩa tại UPLOAD_DIR.
# Trên Vercel, biến này do Blob Storage tự gắn vào project.
UPLOAD_DIR=./data/uploads
BLOB_READ_WRITE_TOKEN=

# ─── Bảo mật ─────────────────────────────────────────────────────────────────
# ⚠️ BẮT BUỘC đổi trước khi deploy — dùng: openssl rand -hex 32
# App từ chối khởi động ở ENVIRONMENT=production nếu còn giá trị mặc định.
SECRET_KEY=doi-chuoi-nay-truoc-khi-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Tài khoản admin khởi tạo. Để trống ADMIN_PASSWORD thì hệ thống tự sinh mật
# khẩu ngẫu nhiên và in ra log đúng một lần lúc nạp dữ liệu lần đầu.
ADMIN_EMAIL=admin@hoahoang.vn
ADMIN_PASSWORD=

# ─── Log ─────────────────────────────────────────────────────────────────────
# Thư mục ghi log theo ngày. Trên serverless (chỉ đọc) sẽ tự bỏ qua ghi file.
LOG_DIR=logs
