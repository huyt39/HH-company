APP_NAME="Hoa Hoang Intra"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=company_db
UPLOAD_DIR=./data/uploads

# ⚠️ BẮT BUỘC đổi trước khi deploy — dùng: openssl rand -hex 32
SECRET_KEY=doi-chuoi-nay-truoc-khi-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Tài khoản admin khởi tạo. Để trống ADMIN_PASSWORD thì hệ thống tự sinh
# mật khẩu ngẫu nhiên và in ra console một lần duy nhất khi seed.
ADMIN_EMAIL=admin@hoahoang.vn
ADMIN_PASSWORD=
